   },
   {
    "s": "B",
    "zh": "一直往前走，然后往左拐。",
    "py": "Yìzhí wǎng qián zǒu, ránhòu wǎng zuǒ guǎi.",
    "en": "Go straight, then turn left."
   },
   {
    "s": "A",
    "zh": "远吗？",
    "py": "Yuǎn ma?",
    "en": "Is it far?"
   },
   {
    "s": "B",
    "zh": "不远，走路五分钟。",
    "py": "Bù yuǎn, zǒulù wǔ fēnzhōng.",
    "en": "Not far, five minutes on foot."
   },
   {
    "s": "A",
    "zh": "谢谢！",
    "py": "Xièxie!",
    "en": "Thanks!"
   }
  ]
 },
 {
  "id": "d5",
  "title": "What time is it?",
  "lines": [
   {
    "s": "A",
