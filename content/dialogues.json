   {
    "s": "A",
    "zh": "不是，我是学生。",
    "py": "Bú shì, wǒ shì xuésheng.",
    "en": "No, I'm a student."
   }
  ]
 },
 {
  "id": "d15",
  "title": "Ordering noodles",
  "you": "B",
  "lines": [
   {
    "s": "A",
