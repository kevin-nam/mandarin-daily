   },
   {
    "s": "A",
    "zh": "有，在这儿。",
    "py": "Yǒu, zài zhèr.",
    "en": "Yes, here you go."
   },
   {
    "s": "B",
    "zh": "这个辣吗？",
    "py": "Zhège là ma?",
    "en": "Is this spicy?"
   },
   {
    "s": "A",
    "zh": "有一点儿辣。",
    "py": "Yǒu yìdiǎnr là.",
    "en": "A little."
   },
   {
    "s": "B",
    "zh": "我要这个，不要辣。",
    "py": "Wǒ yào zhège, bú yào là.",
    "en": "I'll have this, no spice."
   },
   {
    "s": "A",
    "zh": "好的。",
    "py": "Hǎo de.",
    "en": "OK."
   }
  ]
 },
 {
  "id": "d16",
  "title": "For here or to go?",
  "you": "B",
  "lines": [
   {
    "s": "A",
    "zh": "在这儿吃还是带走？",
