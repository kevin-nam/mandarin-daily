   },
   {
    "s": "A",
    "zh": "我叫小明。你呢？",
    "py": "Wǒ jiào Xiǎomíng. Nǐ ne?",
    "en": "I'm Xiaoming. And you?"
   },
   {
    "s": "B",
    "zh": "我叫大卫。",
    "py": "Wǒ jiào Dàwèi.",
    "en": "I'm David."
   },
   {
    "s": "A",
    "zh": "认识你很高兴。",
    "py": "Rènshi nǐ hěn gāoxìng.",
    "en": "Nice to meet you."
   },
   {
    "s": "B",
    "zh": "我也很高兴。",
    "py": "Wǒ yě hěn gāoxìng.",
    "en": "Nice to meet you too."
   }
  ]
 },
 {
  "id": "d14",
  "title": "Can you help me?",
  "you": "A",
  "lines": [
   {
    "s": "A",
    "zh": "不好意思，能帮我一下吗？",
    "py": "Bù hǎoyìsi, néng bāng wǒ yíxià ma?",
    "en": "Excuse me, could you help me?"
   },
   {
    "s": "B",
    "zh": "好的，没问题。",
    "py": "Hǎo de, méi wèntí.",
    "en": "OK, no problem."
   },
   {
    "s": "A",
    "zh": "这个用中文怎么说？",
    "py": "Zhège yòng Zhōngwén zěnme shuō?",
    "en": "How do you say this in Chinese?"
   },
   {
    "s": "B",
    "zh": "等一下……这个叫地铁。",
    "py": "Děng yíxià… zhège jiào dìtiě.",
    "en": "Wait a moment… this is called dìtiě (subway)."
   },
   {
    "s": "A",
    "zh": "谢谢你！",
    "py": "Xièxie nǐ!",
    "en": "Thank you!"
   },
   {
    "s": "B",
    "zh": "不用谢。",
    "py": "Bú yòng xiè.",
    "en": "Don't mention it."
   }
  ]
 },
 {
