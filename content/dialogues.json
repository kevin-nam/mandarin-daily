   },
   {
    "s": "B",
    "zh": "好的，谢谢！",
    "py": "Hǎo de, xièxie!",
    "en": "OK, thanks!"
   }
  ]
 },
 {
  "id": "d17",
  "title": "Bargaining",
  "you": "A",
  "lines": [
   {
