   },
   {
    "s": "A",
    "zh": "三十块吧。",
    "py": "Sānshí kuài ba.",
    "en": "How about thirty."
   },
   {
    "s": "B",
    "zh": "好吧，三十五。",
    "py": "Hǎo ba, sānshíwǔ.",
    "en": "Fine, thirty-five."
   },
   {
    "s": "A",
    "zh": "好的，我要了。",
    "py": "Hǎo de, wǒ yào le.",
    "en": "OK, I'll take it."
   }
  ]
 },
 {
