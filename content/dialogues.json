   {
    "s": "B",
    "zh": "她是医生。",
    "py": "Tā shì yīshēng.",
    "en": "She's a doctor."
   },
   {
    "s": "A",
    "zh": "你有狗吗？",
    "py": "Nǐ yǒu gǒu ma?",
    "en": "Do you have a dog?"
   },
   {
    "s": "B",
    "zh": "没有，我有一只猫。",
    "py": "Méiyǒu, wǒ yǒu yì zhī māo.",
    "en": "No, I have a cat."
   }
  ]
 },
 {
  "id": "d18",
  "title": "I'm lost",
  "you": "A",
  "lines": [
   {
    "s": "A",
    "zh": "不好意思，我迷路了。",
    "py": "Bù hǎoyìsi, wǒ mílù le.",
    "en": "Excuse me, I'm lost."
   },
   {
    "s": "B",
    "zh": "你去哪儿？",
    "py": "Nǐ qù nǎr?",
    "en": "Where are you going?"
   },
   {
    "s": "A",
    "zh": "地铁站怎么走？",
    "py": "Dìtiě zhàn zěnme zǒu?",
