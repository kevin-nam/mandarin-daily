 {
  "id": "d12",
  "title": "A little Chinese",
  "you": "B",
  "lines": [
   {
    "s": "A",
    "zh": "你会说中文吗？",
    "py": "Nǐ huì shuō Zhōngwén ma?",
    "en": "Do you speak Chinese?"
   },
   {
    "s": "B",
    "zh": "我会说一点儿中文。",
    "py": "Wǒ huì shuō yìdiǎnr Zhōngwén.",
    "en": "I can speak a little Chinese."
   },
   {
    "s": "A",
    "zh": "你说得很好！",
    "py": "Nǐ shuō de hěn hǎo!",
    "en": "You speak well!"
   },
   {
    "s": "B",
    "zh": "谢谢！我小时候听过中文。",
    "py": "Xièxie! Wǒ xiǎoshíhou tīngguo Zhōngwén.",
    "en": "Thanks! I heard Chinese as a kid."
   },
   {
    "s": "A",
    "zh": "我说得太快了吗？",
    "py": "Wǒ shuō de tài kuài le ma?",
    "en": "Am I talking too fast?"
   },
   {
    "s": "B",
    "zh": "有点儿快。请说慢一点。",
    "py": "Yǒudiǎnr kuài. Qǐng shuō màn yìdiǎn.",
    "en": "A bit fast. Please speak a little slower."
   }
  ]
 },
 {
  "id": "d13",
  "title": "How do you say this?",
  "you": "A",
  "lines": [
   {
    "s": "A",
    "zh": "请问，这个用中文怎么说？",
    "py": "Qǐngwèn, zhège yòng Zhōngwén zěnme shuō?",
    "en": "Excuse me, how do you say this in Chinese?"
   },
   {
    "s": "B",
    "zh": "这个叫杯子。",
    "py": "Zhège jiào bēizi.",
    "en": "This is called a bēizi (cup)."
   },
   {
    "s": "A",
    "zh": "杯子。谢谢！那个呢？",
    "py": "Bēizi. Xièxie! Nàge ne?",
    "en": "Bēizi. Thanks! And that one?"
   },
   {
    "s": "B",
    "zh": "那个叫手机。",
    "py": "Nàge jiào shǒujī.",
    "en": "That's called a shǒujī (phone)."
   },
   {
    "s": "A",
    "zh": "这是什么意思？",
    "py": "Zhè shì shénme yìsi?",
    "en": "What does this mean?"
   },
   {
    "s": "B",
    "zh": "这是“谢谢”的意思。",
    "py": "Zhè shì “xièxie” de yìsi.",
    "en": "This means “thank you”."
   }
  ]
 },
 {
  "id": "d1",
  "title": "Meeting someone",
  "lines": [
   {
