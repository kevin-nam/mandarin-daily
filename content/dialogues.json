   },
   {
    "s": "B",
    "zh": "在这儿吃。我要一杯水。",
    "py": "Zài zhèr chī. Wǒ yào yì bēi shuǐ.",
    "en": "For here. And a glass of water, please."
   },
   {
    "s": "A",
    "zh": "好的。",
    "py": "Hǎo de.",
    "en": "OK."
   },
   {
    "s": "B",
    "zh": "很好吃！我吃饱了。服务员，买单！",
    "py": "Hěn hǎochī! Wǒ chī bǎo le. Fúwùyuán, mǎidān!",
