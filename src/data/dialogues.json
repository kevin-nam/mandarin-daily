    "py": "Děng yíxià… zhège jiào dìtiě.",
    "en": "Wait a moment… this is called dìtiě (subway)."
   },
   {
    "s": "A",
    "zh": "谢谢你！",
    "py": "Xièxie nǐ!",
    "en": "Thank you!"
   },
   {
    "s": "B",
    "zh": "不用谢。",
    "py": "Bú yòng xiè.",
    "en": "Don't mention it."
   }
