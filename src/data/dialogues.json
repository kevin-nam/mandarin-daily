  "id": "d16",
  "title": "For here or to go?",
  "you": "B",
  "lines": [
   {
    "s": "A",
    "zh": "在这儿吃还是带走？",
    "py": "Zài zhèr chī háishi dài zǒu?",
    "en": "For here or to go?"
   },
   {
    "s": "B",
    "zh": "在这儿吃。我要一杯水。",
