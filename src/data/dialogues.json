    "en": "Delicious! I'm full. Waiter, the bill please!"
   },
   {
    "s": "A",
    "zh": "一共三十块。",
    "py": "Yígòng sānshí kuài.",
    "en": "That's thirty yuan altogether."
   },
   {
    "s": "B",
    "zh": "好的，谢谢！",
    "py": "Hǎo de, xièxie!",
    "en": "OK, thanks!"
