 {
  "id": "d13",
  "title": "How do you say this?",
  "you": "A",
  "lines": [
   {
    "s": "A",
    "zh": "请问，这个用中文怎么说？",
    "py": "Qǐngwèn, zhège yòng Zhōngwén zěnme shuō?",
    "en": "Excuse me, how do you say this in Chinese?"
   },
   {
    "s": "B",
    "zh": "这个叫杯子。",
    "py": "Zhège jiào bēizi.",
    "en": "This is called a bēizi (cup)."
   },
   {
    "s": "A",
    "zh": "杯子。谢谢！那个呢？",
    "py": "Bēizi. Xièxie! Nàge ne?",
    "en": "Bēizi. Thanks! And that one?"
   },
   {
    "s": "B",
    "zh": "那个叫手机。",
    "py": "Nàge jiào shǒujī.",
    "en": "That's called a shǒujī (phone)."
   },
   {
    "s": "A",
    "zh": "这是什么意思？",
    "py": "Zhè shì shénme yìsi?",
    "en": "What does this mean?"
   },
   {
    "s": "B",
    "zh": "这是“谢谢”的意思。",
    "py": "Zhè shì “xièxie” de yìsi.",
    "en": "This means “thank you”."
   }
  ],
